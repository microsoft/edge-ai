{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fabric Ontology Definition",
  "description": "Contract for publishing a static Lakehouse-backed Microsoft Fabric Ontology into existing Fabric resources",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "dataSources", "entityTypes"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "fabric.ontology/v1",
      "description": "Schema version identifier"
    },
    "kind": {
      "type": "string",
      "const": "OntologyDefinition",
      "description": "Resource kind"
    },
    "metadata": {
      "$ref": "#/definitions/metadata"
    },
    "dataSources": {
      "$ref": "#/definitions/dataSources"
    },
    "entityTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/entityType"
      },
      "description": "Entity type definitions"
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/relationship"
      },
      "description": "Relationship definitions between entity types"
    },
    "semanticModel": {
      "$ref": "#/definitions/semanticModel",
      "description": "Experimental Direct Lake semantic-model generation configuration; excluded from the supported static publisher profile"
    }
  },
  "definitions": {
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Ontology display name"
        },
        "description": {
          "type": "string",
          "maxLength": 1024,
          "description": "Ontology description"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version"
        }
      }
    },
    "dataSources": {
      "type": "object",
      "required": ["lakehouse"],
      "additionalProperties": false,
      "properties": {
        "lakehouse": {
          "$ref": "#/definitions/lakehouseDataSource"
        },
        "eventhouse": {
          "$ref": "#/definitions/eventhouseDataSource",
          "description": "Experimental Eventhouse source configuration; excluded from the supported static publisher profile"
        }
      },
      "description": "Existing data resources referenced by ontology bindings; component 033 does not own their infrastructure lifecycle"
    },
    "lakehouseDataSource": {
      "type": "object",
      "required": ["name", "tables"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Lakehouse display name"
        },
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/lakehouseTable"
          }
        }
      }
    },
    "lakehouseTable": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Table name in Lakehouse"
        },
        "sourceFile": {
          "type": "string",
          "description": "Relative path to source data file"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL to download source data file"
        },
        "format": {
          "type": "string",
          "enum": ["csv", "parquet"],
          "default": "csv",
          "description": "Source file format"
        }
      }
    },
    "eventhouseDataSource": {
      "type": "object",
      "required": ["name", "database", "tables"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Eventhouse display name"
        },
        "database": {
          "type": "string",
          "minLength": 1,
          "description": "KQL database name"
        },
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/eventhouseTable"
          }
        }
      }
    },
    "eventhouseTable": {
      "type": "object",
      "required": ["name", "schema"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "KQL table name"
        },
        "sourceFile": {
          "type": "string",
          "description": "Relative path to source data file"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL to download source data file"
        },
        "format": {
          "type": "string",
          "const": "csv",
          "default": "csv"
        },
        "schema": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/kqlColumn"
          },
          "description": "Explicit KQL table schema"
        },
        "policies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "retention": {
              "type": "string",
              "pattern": "^[0-9]+d$",
              "default": "30d",
              "description": "Data retention period (e.g., 30d)"
            },
            "caching": {
              "type": "string",
              "pattern": "^[0-9]+d$",
              "default": "7d",
              "description": "Hot cache period (e.g., 7d)"
            }
          }
        }
      }
    },
    "kqlColumn": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Column name"
        },
        "type": {
          "type": "string",
          "enum": ["string", "int", "double", "datetime", "boolean", "object"],
          "description": "Column data type"
        }
      }
    },
    "entityType": {
      "type": "object",
      "required": ["name", "key", "properties"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Entity type name"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Primary key property name (must match a property name)"
        },
        "displayName": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Property used for entity display name"
        },
        "dataBinding": {
          "allOf": [
            {
              "$ref": "#/definitions/entityDataBinding"
            },
            {
              "properties": {
                "type": {
                  "const": "static"
                }
              }
            }
          ],
          "description": "Single static data binding (use dataBindings for timeseries or multiple bindings)"
        },
        "dataBindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/entityDataBinding"
          },
          "description": "Multiple data bindings (static + timeseries)"
        },
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/entityProperty"
          },
          "description": "Entity properties"
        }
      }
    },
    "entityDataBinding": {
      "type": "object",
      "required": ["type", "source", "table"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["static", "timeseries"],
          "description": "Binding type; timeseries bindings are experimental and excluded from the supported static publisher profile"
        },
        "source": {
          "type": "string",
          "enum": ["lakehouse", "eventhouse"],
          "description": "Data source type"
        },
        "table": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Source table name"
        },
        "timestampColumn": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Timestamp column for timeseries bindings"
        },
        "correlationColumn": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Column linking timeseries to entity key"
        }
      }
    },
    "entityProperty": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Property name"
        },
        "type": {
          "type": "string",
          "enum": ["string", "int", "double", "datetime", "boolean", "object"],
          "description": "Property data type"
        },
        "sourceColumn": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Source table column name (defaults to property name)"
        },
        "binding": {
          "type": "string",
          "enum": ["static", "timeseries"],
          "description": "Which binding this property comes from (for multi-binding entities)"
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["name", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Relationship name"
        },
        "description": {
          "type": "string",
          "maxLength": 1024,
          "description": "Relationship description"
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Source entity type name"
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Target entity type name"
        },
        "cardinality": {
          "type": "string",
          "enum": ["one-to-one", "one-to-many", "many-to-many"],
          "default": "one-to-many",
          "description": "Relationship cardinality"
        },
        "binding": {
          "type": "object",
          "required": ["table", "fromColumn", "toColumn"],
          "additionalProperties": false,
          "properties": {
            "table": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "description": "Table containing the foreign key relationship"
            },
            "fromColumn": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "description": "Column matching source entity key"
            },
            "toColumn": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "description": "Column matching target entity key"
            }
          }
        }
      }
    },
    "semanticModel": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Semantic model display name"
        }
      }
    }
  }
}
