# Local development overrides for the model orchestrator.
# Copy to .env; docker compose reads it automatically.

# Ensemble definition. Every model ID must also be in ADAPTER_ALLOWED_MODELS.
ENSEMBLE_ID=default
MODELS=[{"id":"model-a","result":{"kind":"score","field":"score","threshold":0.5}},{"id":"model-b","result":{"kind":"score","field":"score","threshold":0.7}}]
TIMEOUT_SECONDS=10

# Predict adapter (component 518) used by the compose stack
ADAPTER_ALLOWED_MODELS=model-a,model-b
