# Local development overrides for the model orchestrator.
# Copy to .env; docker compose reads it automatically.

# Ensemble definition. Every model ID must also be in ADAPTER_ALLOWED_MODELS.
ENSEMBLE_ID=default
MODELS=[{"id":"model-a","result":{"kind":"score","field":"score","threshold":0.5}},{"id":"model-b","result":{"kind":"score","field":"score","threshold":0.7}}]
TIMEOUT_SECONDS=10
# Keep at or below ADAPTER_MAX_CONCURRENCY.
MAX_INFLIGHT_MODEL_CALLS=4

# Predict adapter (component 518) used by the compose stack. Keep
# ADAPTER_BACKEND_TIMEOUT_SECONDS x ADAPTER_BACKEND_ATTEMPTS below TIMEOUT_SECONDS.
ADAPTER_ALLOWED_MODELS=model-a,model-b
ADAPTER_MAX_CONCURRENCY=4
ADAPTER_BACKEND_TIMEOUT_SECONDS=4
ADAPTER_BACKEND_ATTEMPTS=2

# Delay every mock model answer, to exercise timeouts and concurrency limits
MOCK_LATENCY_SECONDS=0
