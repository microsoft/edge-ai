# Local development overrides for the sensor simulator.
# Copy to .env; docker compose reads it automatically.

# Simulated asset
ASSET_ID=asset-01
SENSOR_ID=sensor-01
MODALITIES=vibration,acoustic,temperature
PUBLISH_INTERVAL_SECONDS=2
SIMULATOR_SEED=1
INJECT_ANOMALY=false
CONTROL_ENABLED=true

# Samples per acoustic window, 2048-65536. 2048 is the minimum window that
# acoustic consumers such as 521 accept.
ACOUSTIC_SAMPLE_COUNT=2048

# Optional absolute URI sent as the CloudEvents dataschema attribute
DATA_SCHEMA=
