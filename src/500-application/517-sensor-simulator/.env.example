# Local development overrides for the sensor simulator.
# Copy to .env; docker compose reads it automatically.

# Simulated asset
ASSET_ID=asset-01
SENSOR_ID=sensor-01
MODALITIES=vibration,acoustic,temperature
PUBLISH_INTERVAL_SECONDS=2
SIMULATOR_SEED=1
INJECT_ANOMALY=false
CONTROL_ENABLED=true

# Smaller acoustic windows keep local output readable
ACOUSTIC_SAMPLE_COUNT=256
