{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/microsoft/edge-ai/main/src/500-application/517-sensor-simulator/resources/schemas/sensor-reading-v1.schema.json",
  "title": "Sensor reading v1",
  "description": "Payload published to {topicDomain}/v1/{producer}/{resourceKind}/{assetId}/{modality}. Minor versions only add optional fields, so consumers must accept unknown properties.",
  "type": "object",
  "required": ["schema_version", "asset_id", "sensor_id", "modality", "health_state", "timestamp"],
  "properties": {
    "schema_version": {
      "description": "Payload schema version. The major version matches the topic contract version.",
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "asset_id": {
      "description": "Opaque asset identifier, equal to the asset topic segment and the CloudEvents subject.",
      "$ref": "#/$defs/identifier"
    },
    "sensor_id": {
      "description": "Opaque sensor identifier.",
      "$ref": "#/$defs/identifier"
    },
    "modality": {
      "description": "Signal modality, equal to the last topic segment.",
      "enum": ["vibration", "acoustic", "temperature"]
    },
    "health_state": {
      "description": "Synthetic ground truth for scoring downstream results.",
      "enum": ["healthy", "faulty"]
    },
    "timestamp": {
      "description": "Generation time, RFC 3339 UTC with millisecond precision.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "modality": { "const": "acoustic" } },
        "required": ["modality"]
      },
      "then": { "$ref": "#/$defs/acoustic" },
      "else": { "$ref": "#/$defs/scalar" }
    },
    {
      "if": {
        "properties": { "modality": { "const": "vibration" } },
        "required": ["modality"]
      },
      "then": { "properties": { "unit": { "const": "mm/s" } } }
    },
    {
      "if": {
        "properties": { "modality": { "const": "temperature" } },
        "required": ["modality"]
      },
      "then": { "properties": { "unit": { "const": "degC" } } }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{1,64}$"
    },
    "scalar": {
      "description": "Single value for the vibration and temperature modalities.",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string" }
      }
    },
    "acoustic": {
      "description": "Fixed-length mono waveform window, normalized to [-1, 1].",
      "required": ["sample_rate", "samples"],
      "properties": {
        "sample_rate": {
          "description": "Samples per second in Hz.",
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "samples": {
          "type": "array",
          "minItems": 2048,
          "maxItems": 65536,
          "items": { "type": "number", "minimum": -1, "maximum": 1 }
        }
      }
    }
  }
}
