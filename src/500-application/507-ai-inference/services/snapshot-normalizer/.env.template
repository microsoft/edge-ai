# Snapshot normalizer settings for docker-compose.
# docker-compose loads this file, then .env in this directory when present.
# Copy it to .env to override values; .env is ignored by git.

# MQTT connection (Azure IoT Operations SDK variables)
AIO_MQTT_USE_TLS=false
AIO_MQTT_CLIENT_ID=snapshot-normalizer
AIO_BROKER_HOSTNAME=host.docker.internal
AIO_BROKER_TCP_PORT=1883
AIO_MQTT_SESSION_EXPIRY=3600

# Opaque identifiers; CAMERA_ID becomes a topic segment
CAMERA_ID=camera-01
DEVICE_NAME=camera-device-01

# Binary JPEG snapshot topic to normalize
INPUT_TOPIC=media/v1/local/camera-01/snapshots

# Optional; defaults to edge-ai/v1/snapshot-normalizer/camera/{CAMERA_ID}/snapshots
# OUTPUT_TOPIC=

RUST_LOG=info
