# Local development overrides for the MQTT predict adapter.
# Copy to .env; docker compose reads it automatically.

# Models the adapter serves. The compose stack's mock model answers for any ID.
ALLOWED_MODELS=sensor-anomaly

# {model_id} is replaced with the requested model ID.
MODEL_ENDPOINT_TEMPLATE=http://mock-model:8000/{model_id}/v1/predict

MAX_CONCURRENCY=4
BACKEND_TIMEOUT_SECONDS=10
