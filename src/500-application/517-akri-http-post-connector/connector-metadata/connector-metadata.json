{
  "$schema": "https://json.schemastore.org/aio-connector-metadata-11.0-preview.json",
  "inboundEndpoints": [
    {
      "endpointType": "EdgeAi.HttpPost",
      "version": "1.0",
      "datasets": {
        "datasetConfigurationSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "request", "samplingIntervalMs"],
          "properties": {
            "schemaVersion": { "const": 2 },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bodySecretAlias", "contentType"],
              "properties": {
                "bodySecretAlias": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[A-Za-z0-9_.-]+$"
                },
                "contentType": { "type": "string", "minLength": 1 },
                "idempotent": { "type": "boolean", "default": false }
              }
            },
            "samplingIntervalMs": { "type": "integer", "minimum": 100 }
          }
        }
      }
    }
  ]
}
