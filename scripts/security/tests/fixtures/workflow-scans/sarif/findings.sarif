{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": { "driver": { "name": "Test-ActionPinProvenance", "rules": [] } },
      "results": [
        {
          "ruleId": "action-pin/comment-not-release",
          "level": "note",
          "message": { "text": "owner/action is labeled with the moving tag v1" },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": ".github/workflows/fuzz.yml" }, "region": { "startLine": 10 } } }]
        },
        {
          "ruleId": "action-pin/comment-not-release",
          "level": "note",
          "message": { "text": "owner/action is labeled with the moving tag v1" },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "./.github/workflows/fuzz.yml" }, "region": { "startLine": 20 } } }]
        },
        {
          "ruleId": "action-pin/comment-mismatch",
          "level": "error",
          "message": { "text": "actions/checkout is labeled v4.2.2 but the commit is v7.0.1" },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": ".github/workflows/ci.yml" }, "region": { "startLine": 5 } } }],
          "suppressions": [{ "kind": "inSource" }]
        }
      ]
    }
  ]
}
