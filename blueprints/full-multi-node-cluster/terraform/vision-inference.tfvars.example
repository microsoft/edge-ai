/*
 * Vision inference profile for the full-multi-node-cluster blueprint
 *
 * Deploys the public Media connector template and a camera asset that publishes
 * binary JPEG snapshots for the component 507 snapshot normalizer.
 */

environment     = "dev"
location        = "eastus2"
resource_prefix = "vision"
instance        = "001"

should_enable_akri_media_connector = true

namespaced_devices = [
  {
    name    = "camera-01"
    enabled = true
    endpoints = {
      inbound = {
        "camera-01-media" = {
          endpoint_type = "Microsoft.Media"
          address       = "rtsp://192.0.2.10:554/stream"
          authentication = {
            method = "Anonymous"
          }
        }
      }
    }
  }
]

namespaced_assets = [
  {
    name         = "camera-01-snapshots"
    display_name = "Camera 01 Snapshots"
    device_ref = {
      device_name   = "camera-01"
      endpoint_name = "camera-01-media"
    }
    description = "Periodic JPEG snapshots for local vision inference"
    attributes = {
      assetType = "media-snapshots"
    }
    datasets = [
      {
        name                  = "snapshots"
        data_source           = ""
        dataset_configuration = "{\"taskType\":\"snapshot-to-mqtt\",\"intervalSeconds\":5,\"quality\":85}"
        data_points           = []
        destinations = [
          {
            target = "Mqtt"
            configuration = {
              topic = "edge-ai/cameras/snapshots/raw"
            }
          }
        ]
      }
    ]
  }
]